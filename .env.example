# Application
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production

# CORS (источники браузерной админки, через запятую; пусто = выключено)
CORS_ORIGINS=http://localhost:5173

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=smenka
POSTGRES_PASSWORD=smenka
POSTGRES_DB=smenka

# Auth
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Чек-листы: через сколько дней удалять объект фото чек-листа из S3
# (Celery purge_expired_files, правило checklist_photo). 0 — правило выключено.
CHECKLIST_PHOTO_RETENTION_DAYS=30
# storage_housekeeping: срок хранения фото старта смены без геопроверки
# (правило shift_geo_photo). 0 — правило выключено.
SHIFT_GEO_PHOTO_RETENTION_DAYS=90
# storage_housekeeping: через сколько дней после удаления организации удалять
# объекты всех её файлов (правило deleted_organization). 0 — правило выключено.
DELETED_ORG_FILE_RETENTION_DAYS=30
# storage_housekeeping: сверка "объекты S3 без строки в files" (Celery
# reconcile_storage_objects, еженедельно). false — задача не опрашивает S3.
STORAGE_RECONCILE_ENABLED=false
# Предохранитель: кандидатов больше этого числа за запуск — не удалять ничего.
STORAGE_RECONCILE_MAX_DELETES=1000

# ЮKassa (online_payments) — онлайн-оплата подписки. YOOKASSA_ENABLED=false
# (дефолт) полностью выключает фичу. YOOKASSA_MODE=test/live определяет,
# какая пара shopId/secretKey активна, и проставляется в payments.is_test.
# Реальные креды тестового магазина в репозиторий не коммитятся — они у
# владельца проекта.
YOOKASSA_ENABLED=false
YOOKASSA_MODE=test
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL_BASE=http://localhost:5173
BILLING_MAX_PAYMENT_MINOR=10000000
