# Шаблон прод-окружения. На сервере скопировать в .env и заполнить.
# Реальный .env в git НЕ коммитится.
# Один файл читают api / worker / migrate (а POSTGRES_* — ещё и сам контейнер db).

# ── Домены (Caddy выпустит TLS под них автоматически) ──
API_DOMAIN=api.example.com
ADMIN_DOMAIN=admin.example.com
# Поддомен мониторинга Celery (Flower). Закрыт basic-auth (FLOWER_BASIC_AUTH ниже).
FLOWER_DOMAIN=flower.example.com
# Корневой домен с лендингом. Caddy отдаёт статику из /opt/smenka/landing,
# www.<домен> редиректится сюда же. A-записи `@` и `www` должны смотреть на VPS.
LANDING_DOMAIN=example.com

# ── Теги образов из ghcr (можно запиннить на sha-xxxxxxx для отката) ──
BACK_TAG=latest
ADMIN_TAG=latest
# Веб-версия мобилки (flutter build web) — образ ghcr.io/becandier/smenka_web (репо smenka_mobile).
WEB_TAG=latest

# ── Приложение ──
APP_ENV=production
DEBUG=false
# Сгенерировать: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_OPENSSL_RAND_HEX_32

# ── PostgreSQL (хост = имя сервиса `db` внутри compose-сети) ──
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=smenka
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=smenka

# ── Redis / Celery (хост = имя сервиса `redis`) ──
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Auth ──
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── CORS ──
# Поле cors_origins в config.py + CORSMiddleware в main.py (включается только при непустом значении).
# Список origins браузерных клиентов через запятую. Пусто = браузерный доступ запрещён.
# Сюда входят: веб-админка (admin) И веб-версия мобилки (web_cors — flutter build web).
# allow_credentials=False — клиенты шлют JWT в Authorization, не cookie.
CORS_ORIGINS=https://admin.example.com,https://app.example.com

# Домен web-версии мобилки (flutter build web), который раздаёт Caddy (см. infra/caddy/Caddyfile).
# Этот же домен ОБЯЗАН присутствовать в CORS_ORIGINS выше, иначе запросы из браузера упрутся в CORS.
WEB_DOMAIN=app.example.com

# ── Sentry (error-tracking бэка — security_hardening) ──
# Пустой DSN = Sentry выключен (dev/CI). В проде ДОЛЖЕН быть задан.
# Заводится при деплое (DEPLOY_NOTES §2). Читается backend-кодом фичи security_hardening.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Версия релиза для группировки в Sentry — проставляется деплоем (BACK_TAG/commit-sha).
# Можно оставить пустым (тогда release не привязан).
SENTRY_RELEASE=
# Доля трассируемых транзакций (0.0–1.0). Старт — 0.0, поднимать точечно.
SENTRY_TRACES_SAMPLE_RATE=0.0

# ── Отправка кодов подтверждения по email (smtp_email, транспорт — Loops) ──
# Пустой LOOPS_API_KEY = отправка выключена (dev/CI): код возвращается в ответе
# register/resend и пишется в лог, письмо не шлётся. Непустой key (прод) = код уходит
# ТОЛЬКО письмом, в ответе verification_code=null, в логи код не пишется.
LOOPS_API_KEY=CHANGE_ME_LOOPS_API_KEY
# id опубликованного transactional-шаблона «Verification code» в Loops.
LOOPS_TRANSACTIONAL_ID=cmsfl5itc0s120j1ergdqtd55
# Эндпоинт Loops transactional API — дефолт достаточен, переопределять не нужно.
LOOPS_API_URL=https://app.loops.so/api/v1/transactional
# Таймаут HTTP-запроса к Loops (сек).
LOOPS_TIMEOUT_SECONDS=10

# ── Защита от брутфорса (security_hardening) ──
# Дефолты разумны; читаются backend-кодом (slowapi + lockout). Менять при необходимости.
# Формат лимитов slowapi: "<кол-во>/<период>" (можно несколько через ';').
LOGIN_RATE_LIMIT=5/minute;30/hour
VERIFY_RATE_LIMIT=10/minute;50/hour
RESEND_RATE_LIMIT=3/minute;10/hour
REGISTER_RATE_LIMIT=5/minute;20/hour
OAUTH_LOGIN_RATE_LIMIT=5/minute;30/hour
# Сколько неверных вводов кода верификации до его аннулирования.
MAX_CODE_ATTEMPTS=5
# Сколько неудачных логинов подряд до блокировки аккаунта и на сколько минут.
MAX_LOGIN_FAILURES=10
ACCOUNT_LOCKOUT_MINUTES=15

# ── Flower (мониторинг Celery) ──
# Basic-auth самого Flower, формат user:pass. Задать сильный пароль при деплое.
FLOWER_BASIC_AUTH=admin:CHANGE_ME_STRONG_PASSWORD

# ── Файловое хранилище S3 (file_storage) ──
# В проде — managed S3 провайдера (Yandex Object Storage / Timeweb S3 / AWS S3 / Selectel),
# НЕ self-hosted MinIO. Бакет приватный; клиенты качают по presigned URL.
# Заводится при появлении VPS (см. ../docs/tasks/file_storage/devops.md). Читается backend-кодом.
#
# Внутренний адрес для SDK. Для AWS можно оставить пустым (берётся регион).
S3_ENDPOINT_URL=https://s3.example-provider.com
# Хост в presigned URL (публичный домен бакета). Пусто = S3_ENDPOINT_URL.
S3_PUBLIC_ENDPOINT_URL=https://smenka-files-prod.s3.example-provider.com
S3_REGION=ru-central1
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=smenka-files-prod
S3_USE_SSL=true
# path-style: false для AWS, true для большинства совместимых провайдеров.
S3_FORCE_PATH_STYLE=true
# TTL presigned GET (сек).
S3_PRESIGN_EXPIRE_SECONDS=3600
# Глобальный потолок размера загрузки (МБ); должен быть >= максимума per-category.
MAX_UPLOAD_SIZE_MB=50
# Через сколько часов чистить неприкреплённые файлы-сироты (Celery cleanup_orphan_files).
ORPHAN_FILE_TTL_HOURS=24

# ── Чек-листы ──
# Максимум фото-подтверждений на один пункт чек-листа (антифрод).
CHECKLIST_MAX_PHOTOS_PER_ITEM=10
