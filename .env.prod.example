# Шаблон прод-окружения. На сервере скопировать в .env и заполнить.
# Реальный .env в git НЕ коммитится.
# Один файл читают api / worker / migrate (а POSTGRES_* — ещё и сам контейнер db).

# ── Домены (Caddy выпустит TLS под них автоматически) ──
API_DOMAIN=api.example.com
ADMIN_DOMAIN=admin.example.com

# ── Теги образов из ghcr (можно запиннить на sha-xxxxxxx для отката) ──
BACK_TAG=latest
ADMIN_TAG=latest

# ── Приложение ──
APP_ENV=production
DEBUG=false
# Сгенерировать: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_OPENSSL_RAND_HEX_32

# ── PostgreSQL (хост = имя сервиса `db` внутри compose-сети) ──
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=smenka
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=smenka

# ── Redis / Celery (хост = имя сервиса `redis`) ──
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Auth ──
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Смены ──
DEFAULT_AUTO_FINISH_HOURS=16

# ── CORS ──
# ⚠️ Переменная инертна, пока не реализован Блок A фичи admin_panel
# (поле cors_origins в config.py + CORSMiddleware в main.py). До этого не читается.
# Список origins веб-админки через запятую. Пусто = браузерный доступ запрещён.
CORS_ORIGINS=https://admin.example.com
